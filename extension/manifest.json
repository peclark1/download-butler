{
  "manifest_version": 3,
  "name": "Download Butler",
  "version": "0.2.0",
  "description": "Prompt for downloads, remember destinations, and batch-download links from a selection.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Download Butler",
    "default_popup": "popup.html"
  }
}
